# Outillage agent (ruflo / Claude Code) — purement local, ne fait pas partie du site.
# Se réinstalle avec la commande d'installation de ruflo, donc rien à versionner.
.claude/*
!.claude/launch.json
.claude-flow/
.agents/
.swarm/
.mcp.json

# Scripts d'extraction et de migration utilisés pendant la refonte — locaux, jamais servis.
_preview/

# Sortie du graphe de connaissances — se régénère, jamais servie.
graphify-out/

# Bases de données runtime générées par ruflo
ruvector.db
*.db-journal
*.db-wal
*.db-shm

# Cache de compilation Python (py -m py_compile)
__pycache__/

# Coffre Obsidian cree par accident dans le depot. Rien du site n'y est.
Chronologeek/

# Sortie de la traduction : ce qu'il a fallu ecrire en anglais faute de prod a
# reprendre. Entierement reecrit par traduire.mjs, traduire-pages.mjs et
# relecture.mjs a chaque passe, donc rien a versionner — et la relecture se fait
# au navigateur sur le proto anglais, pas dans un document.
_proto/A-RELIRE-EN.md
_proto/a-traduire.json
_proto/a-traduire-pages.json
_proto/a-relire-pages.json
_proto/a-traduire-startrek.json
_proto/a-relire-startrek.json
_proto/a-traduire-twd.json
_proto/a-relire-twd.json
